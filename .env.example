# Firebase 웹 앱 config — 글로벌 리더보드(Firestore)용.
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱(웹) 의 firebaseConfig 값을 복사.
# 이 파일을 `.env` 로 복사한 뒤 값을 채우면 글로벌 리더보드가 활성화된다.
# (값이 없으면 글로벌은 오프라인 — 개인 로컬 기록만 동작.)
#
# 이 키들은 비밀이 아니라 공개 식별자다(노출돼도 무방). 접근 제어는 firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
